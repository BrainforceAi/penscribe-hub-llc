      "headers": {
        "Authorization": "Bearer ${PARTNER_FEED_TOKEN}"
      },
      "itemsPath": "jobs",
      "pagination": {
        "param": "page",
        "start": 1,
        "maxPages": 50
      },
      "map": {
        "id": "id",
        "title": "title",
        "company": "company",
        "location": "location",
